# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your-api-key-here

# Server Configuration
PORT=4001
FRONTEND_PORT=4000

# Session signing secret (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: initial admin password used by `npm run db:auth` (random if unset)
# ADMIN_PASSWORD=

# Next.js Frontend URL (used by backend for CORS)
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# Optional: Email notifications (uncomment and configure to enable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
# NOTIFICATION_EMAIL=your-email@gmail.com
