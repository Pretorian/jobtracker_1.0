{
  "name": "job-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "up": "bash scripts/dev-up.sh",
    "predev": "lsof -ti:4000,4001 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:server\"",
    "dev:next": "next dev -p 4000",
    "dev:server": "nodemon server/index.js",
    "build": "next build",
    "start": "npm run start:server",
    "start:server": "node server/index.js",
    "lint": "next lint",
    "a11y:sync": "mkdir -p public/a11y && cp node_modules/a11y.css/css/a11y-en*.css public/a11y/",
    "db:init": "node server/db/init.js",
    "db:auth": "node server/db/migrate-auth.js",
    "db:multi-user": "node server/db/migrate-multi-user.js",
    "notify": "node scripts/daily-followup.js",
    "search": "node scripts/auto-job-search.js",
    "search:preview": "node scripts/auto-job-search.js --dry-run",
    "health": "node scripts/health-check.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.85.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docxtemplater": "^3.50.0",
    "dotenv": "^17.4.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.5.14",
    "node-cron": "^3.0.3",
    "pizzip": "^3.1.7",
    "playwright": "^1.59.1",
    "puppeteer-screen-recorder": "^3.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-filename": "^1.6.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "a11y.css": "^5.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.14",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
